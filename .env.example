# FED KIIT — environment template
#
# Copy to `.env.local` and fill in. The real values were carried over from the
# Express backend's .env and the Vite frontend's .env during the migration.
#
# `lib/env.ts` validates this on first access, so a missing required value fails
# loudly at boot rather than as a 500 halfway through a request.

# --- Database ---------------------------------------------------------------
# MongoDB Atlas connection string (required).
DATABASE_URL=

# --- Auth -------------------------------------------------------------------
# Must match the old backend's JWT_SECRET so sessions issued before the cutover
# keep verifying and nobody is logged out by the migration. Min 16 chars.
JWT_SECRET=
SESSION_SECRET=
# bcrypt cost. Was VITE_BCRYPT on the frontend, which hashed in the browser;
# hashing is now server-side. Stored hash format is unchanged.
BCRYPT_SALT_ROUNDS=10

# --- Google OAuth -----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Email (Resend) ---------------------------------------------------------
# Two senders: the app tries the primary, then falls back to the secondary.
RESEND_API_KEY=
EMAIL_FROM=
RESEND_API_KEY_2=
EMAIL_FROM_2=

# --- Cloudinary -------------------------------------------------------------
CLOUDINARY_URL=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# --- Razorpay ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Gemini / chatbot -------------------------------------------------------
# Up to ten keys; the chatbot rotates to the next one when a key is rate limited.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_MODEL=gemini-2.0-flash
CHATBOT_NAME=FEDI
NEXT_PUBLIC_CHATBOT_NAME=FEDI

# --- Certificates -----------------------------------------------------------
CERT_ORG=
NEXT_PUBLIC_CERT_ORG=

# --- Server -----------------------------------------------------------------
# Port the Next.js server listens on, for both `npm run dev` and `npm start`.
#
# Next cannot read PORT from a .env file on its own — the HTTP server boots
# before any application code is initialised. The npm scripts therefore load
# these files with Node's own `--env-file-if-exists` flag before invoking next.
#
# Precedence: shell environment > .env.local > .env, so a hosting platform that
# injects PORT (Vercel, Render, Railway…) still wins over anything set here.
PORT=3000

# --- Site -------------------------------------------------------------------
# The PUBLIC canonical origin, with no trailing slash.
#
# This must be the live domain even in development: it is what every
# `rel=canonical`, OpenGraph URL and sitemap entry is built from. The old
# backend's DOMAIN variable held "http://localhost:5173/" (the Vite dev server),
# which would have published a sitemap full of localhost URLs.
NEXT_PUBLIC_SITE_URL=https://www.fedkiit.com

# --- Tunables ---------------------------------------------------------------
# All optional. Every default below reproduces the previous hardcoded value, so
# leaving them unset changes nothing.

# One-time passwords. NEXT_PUBLIC so OtpInput draws exactly this many boxes —
# one variable for both sides means the code length and the UI cannot desync.
NEXT_PUBLIC_OTP_LENGTH=4
OTP_VALIDITY_MINUTES=15

# Extra hosts allowed to appear in an Origin header when building an emailed
# invite link. Comma-separated. The canonical site host, localhost and 127.0.0.1
# are always trusted; this is for staging and preview deployments.
# e.g. TRUSTED_ORIGIN_HOSTS=staging.fedkiit.com,fed-frontend.vercel.app
TRUSTED_ORIGIN_HOSTS=

# Addresses that may read form analytics regardless of role. Comma-separated.
# Previously the literal srex@fedkiit.com in the route.
FORM_ANALYTICS_ALLOWED_EMAILS=srex@fedkiit.com

# Addresses that may scan QRs and mark attendance regardless of role.
# Comma-separated. For shared door-scanning accounts that are plain USERs and
# should not be promoted to ADMIN just to run a scanner — an ADMIN can also
# edit and delete events, which a shared login has no business doing.
# e.g. FORM_ATTENDANCE_ALLOWED_EMAILS=attendance@fedkiit.com
FORM_ATTENDANCE_ALLOWED_EMAILS=

# Calendar month (1-12) the academic year rolls over in. Used to derive the year
# of study from a KIIT roll number, so a 2022 intake stays 4th Year until July
# 2026 rather than being promoted every 1 January.
ACADEMIC_YEAR_START_MONTH=7

LOG_REQ=false
DEBUG=false
